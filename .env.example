# Jobs Radar environment. Copy to .env (untracked) or run ./jobs-radar.sh --init-env, which fills
# the secrets below with random values. Never commit .env. Every variable is documented in
# docs/operations/configuration-reference.md.

JOBS_RADAR_ENV=dev                 # dev | test | prod
JOBS_RADAR_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Ports and exposure (ADR-019) ---
JOBS_RADAR_API_PORT=8100
JOBS_RADAR_FRONTEND_PORT=5180
JOBS_RADAR_DB_PORT=5440
# Address the PostgreSQL port is published on. Loopback by default: only this machine can connect.
# Use 0.0.0.0 (or this machine's LAN IP) to connect with a database tool from another computer; the
# database holds all your data, so prefer an SSH tunnel to this machine when you can.
JOBS_RADAR_DB_BIND=127.0.0.1
# Loopback only by default because V1 has no authentication. Set 0.0.0.0 to expose on the LAN.
JOBS_RADAR_API_BIND=127.0.0.1
JOBS_RADAR_CORS_ORIGINS=["http://127.0.0.1:5180","http://localhost:5180"]
# Host names the Vite dev server accepts (comma separated). Add this machine's name to open the UI
# from another computer, for example: localhost,127.0.0.1,iw-dev-01
JOBS_RADAR_FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
JOBS_RADAR_DB_HOST=127.0.0.1
JOBS_RADAR_DB_NAME=jobs_radar
JOBS_RADAR_DB_USER=jobs_radar
JOBS_RADAR_DB_PASSWORD=            # filled by --init-env

# --- Secrets (ADR-033) ---
# Key used to encrypt stored credentials. Back it up separately: without it stored credentials
# cannot be recovered. Generated by --init-env.
JOBS_RADAR_CREDENTIAL_KEY=

# Load the domain packs shipped with the application at start-up (ADR-080). Leave it on.
JOBS_RADAR_LOAD_PACKS=true

# --- Local AI (ADR-035, ADR-038) ---
JOBS_RADAR_OLLAMA_URL=http://host.docker.internal:11434
# Optional: the AI & privacy screen has the same switch (ADR-081); true here forces it on.
JOBS_RADAR_ALLOW_LOCAL_PROVIDERS=false
# Only seeds the first local connection; a connection added in AI & privacy is enough to score jobs.
JOBS_RADAR_EXTRACTION_ENABLED=false
# Default local models (owner decision; the AI & privacy screen can change them later).
JOBS_RADAR_EXTRACTION_MODEL=qwen3:8b
JOBS_RADAR_EMBEDDING_MODEL=qwen3-embedding:8b
# Longest description sent to the model, in characters (longer text is truncated and flagged).
JOBS_RADAR_EXTRACTION_MAX_CHARS=12000
# Seconds one local-model call may take.
JOBS_RADAR_OLLAMA_TIMEOUT_SECONDS=180

# --- Worker (ADR-031) ---
JOBS_RADAR_WORKER_POLL_SECONDS=15
# Jobs sent to the model at once; raise together with OLLAMA_NUM_PARALLEL (ADR-077).
JOBS_RADAR_EXTRACTION_CONCURRENCY=1
JOBS_RADAR_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# --- MCP server for AI agents (ADR-078) ---
# Lets an agent (Claude Code, a local model behind an MCP client, ...) read your inbox, scores,
# trends and profile. OFF unless the value is exactly "true". Anything the agent reads goes to the
# model behind it: with a cloud agent that includes your profile. See docs/operations/mcp-server.md.
JOBS_RADAR_MCP_ENABLED=false
# Also register the tools that change your inbox (shortlist, ignore, ...) and queue collections.
# Needs JOBS_RADAR_MCP_ENABLED=true as well.
JOBS_RADAR_MCP_ALLOW_WRITES=false
# Optional: where the MCP server finds the API (default http://127.0.0.1:<JOBS_RADAR_API_PORT>) and
# the seconds it waits for an answer (default 15).
# JOBS_RADAR_MCP_API_URL=http://127.0.0.1:8100
# JOBS_RADAR_MCP_TIMEOUT_SECONDS=15
